PORT=8080
NODE_ENV=development
AUTH_SERVICE_URL=http://127.0.0.1:3000
JWT_SECRET=example-jwt-secret-must-be-at-least-32-characters
EXAONE_API_KEY=example-exaone-api-key
EXAONE_API_BASE_URL=https://api.exaone.ai/v1

# Optional serverless cache & distributed lock (Upstash Redis REST API). Falls back to in-memory when unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# AUTH_USER_CACHE_TTL_MS=30000

# Optional shared secret protecting POST /internal/events/* (Pub/Sub Push / local fan-out)
# INTERNAL_EVENT_TOKEN=replace-with-shared-internal-event-token
