# Neon PostgreSQL connection string (services/learning dedicated DB: innova_learning)
# e.g. postgresql://[user]:[password]@[endpoint]/innova_learning?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/innova_learning?sslmode=require

# Auth microservice URL for per-request approval validation (GET /api/auth/me)
# Cloud Run: https://innova-auth-api-[hash]-[region].run.app or Gateway: http://127.0.0.1:8080
AUTH_SERVICE_URL=http://127.0.0.1:3001

# Cookie name for authentication (default: innova_auth)
AUTH_COOKIE_NAME=innova_auth

# JWT secret (min 32 chars) shared across platform services
JWT_SECRET=change-this-to-a-secure-secret-with-at-least-32-chars

# Curriculum private asset GCS bucket (default: innova-assets)
CURRICULUM_ASSET_BUCKET=innova-assets

# Optional: Local asset root for offline filesystem reader (fallback when CURRICULUM_ASSET_BUCKET is unset)
# CURRICULUM_ASSET_ROOT=/path/to/assets

# Optional: Static GCP storage token (when running outside GCP metadata server environment)
# GCP_STORAGE_TOKEN=

# Optional: Local seed path for private exam bank
# EXAM_BANK_SEED_PATH=/path/to/private-bank.json

# Service Port
PORT=3003

# Optional serverless cache (Upstash Redis REST API) & cache TTLs. Falls back to in-memory when unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# AUTH_USER_CACHE_TTL_MS=30000
# EXAM_BANK_CACHE_TTL_MS=300000

# Optional shared secret protecting POST /internal/events/* (Pub/Sub Push / local fan-out)
# INTERNAL_EVENT_TOKEN=replace-with-shared-internal-event-token
