# Neon `innova_auth` database (users only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/innova_auth?sslmode=require

# JWT secret for authentication. At least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Defaults to innova_auth.
AUTH_COOKIE_NAME=innova_auth

# Optional. Defaults to info when unset.
LOG_LEVEL=info

# Optional. Defaults to 8080.
PORT=8080
