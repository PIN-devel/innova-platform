# Neon `innova_auth` database (users only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/innova_auth?sslmode=require

# Optional, transition period only (until PIN-78).
# Existing monolith database (`neondb`). When set, signup/approval/rejection
# are mirrored to its `users` table so the Render API keeps seeing the same users.
LEGACY_DATABASE_URL=

# Must match the Render API secret while both services issue/verify sessions. At least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Defaults to innova_auth.
AUTH_COOKIE_NAME=innova_auth

# Optional. Defaults to info when unset.
LOG_LEVEL=info

# Optional. Defaults to 8080.
PORT=8080
