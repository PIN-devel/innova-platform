# Neon `innova_auth` database (users only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/innova_auth?sslmode=require

# JWT secret for authentication. At least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Defaults to innova_auth.
AUTH_COOKIE_NAME=innova_auth

# Optional. Defaults to info when unset.
LOG_LEVEL=info

# Optional. Defaults to 8080.
PORT=8080

# Optional serverless cache & distributed lock (Upstash Redis REST API). Falls back to in-memory when unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional domain event publishing:
# - Cloud Run / GCP: set PUBSUB_PROJECT_ID and PUBSUB_USER_EVENTS_TOPIC
# - Local HTTP Fan-out: set EVENT_SUBSCRIBER_URLS (comma-separated internal webhook URLs)
# PUBSUB_PROJECT_ID=
# PUBSUB_USER_EVENTS_TOPIC=innova-user-events
# EVENT_SUBSCRIBER_URLS=http://127.0.0.1:3003/internal/events/user-status,http://127.0.0.1:3002/internal/events/user-status,http://127.0.0.1:3004/internal/events/user-status
# INTERNAL_EVENT_TOKEN=replace-with-shared-internal-event-token
