{
  "name": "@innova/finance",
  "version": "0.1.0",
  "description": "Innova personal finance (MOTIFIN) service",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @innova/auth-kit build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c ../../.oxlintrc.json src test drizzle.config.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.2",
    "@innova/auth-kit": "workspace:*",
    "@innova/contracts": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
