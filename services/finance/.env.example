# Neon `innova_finance` database (finance_* tables only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/innova_finance?sslmode=require

# Auth microservice base URL (`innova-auth-api`) for per-request user/approval lookup
# and PDF password step-up re-authentication over HTTP. Never connect to `innova_auth` DB directly.
AUTH_SERVICE_URL=http://127.0.0.1:3001

# Must match the auth service secret. At least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Defaults to innova_auth.
AUTH_COOKIE_NAME=innova_auth

# Raw field encryption (independent random 32-byte key, hex). Never reuse JWT_SECRET.
FINANCE_RAW_ENCRYPTION_KEY=
# Exact allowed browser origins for mutations; comma-separated, no wildcard.
FINANCE_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Optional account-stored PDF password. Independent random 256-bit keys, never Raw/JWT keys.
# JSON map {"v1":"<64 random hex characters>"}; retain old versions until migration/backup review.
FINANCE_PDF_PASSWORD_KEYRING=
FINANCE_PDF_PASSWORD_ACTIVE_KEY_VERSION=v1

# Optional. Defaults to info when unset.
LOG_LEVEL=info

# Optional. Defaults to 8080.
PORT=8080
