{
  "name": "innova-platform",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build:shared": "pnpm --filter @innova/contracts build && pnpm --filter @innova/auth-kit build",
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @innova/contracts build && pnpm --filter @innova/web dev",
    "dev:auth": "pnpm build:shared && pnpm --filter @innova/auth dev",
    "dev:learning": "pnpm build:shared && pnpm --filter @innova/learning dev",
    "dev:finance": "pnpm build:shared && pnpm --filter @innova/finance dev",
    "dev:ai": "pnpm build:shared && pnpm --filter @innova/ai dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:shared && pnpm -r --filter './apps/**' --filter './services/**' --filter @innova/auth-kit --filter @innova/contracts typecheck",
    "test": "pnpm build:shared && pnpm -r --filter './apps/**' --filter './services/**' test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  }
}
