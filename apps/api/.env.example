DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Set a unique random secret of at least 32 characters; the API refuses to start without one.
JWT_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=info
# Optional private runtime directory, with relative paths matching assetKey.
# Leave unset when private textbook images are unavailable in the deployment.
CURRICULUM_ASSET_ROOT=
