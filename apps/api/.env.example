DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Set a unique random secret of at least 32 characters; the API refuses to start without one.
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Defaults to info when unset.
LOG_LEVEL=info

# Optional. Used only when serving Curriculum assets from a local filesystem.
# Paths under this directory must match Curriculum assetKey values.
# If unset, no filesystem asset backend is configured.
CURRICULUM_ASSET_ROOT=

# Server-only credential for Vercel Private Blob Curriculum assets.
# Never expose a real token to the browser or commit it to Git.
BLOB_READ_WRITE_TOKEN=

# Curriculum asset backend selection:
# 1. BLOB_READ_WRITE_TOKEN set -> Vercel Private Blob
# 2. otherwise CURRICULUM_ASSET_ROOT set -> local filesystem
# 3. otherwise -> private Curriculum assets are unavailable

# Raw field encryption (independent random 32-byte key, hex). Never reuse JWT_SECRET.
FINANCE_RAW_ENCRYPTION_KEY=
# Exact allowed browser origins for Raw mutations; comma-separated, no wildcard.
FINANCE_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Optional account-stored PDF password. Independent random 256-bit keys, never Raw/JWT keys.
# JSON map {"v1":"<64 random hex characters>"}; retain old versions until migration/backup review.
FINANCE_PDF_PASSWORD_KEYRING=
FINANCE_PDF_PASSWORD_ACTIVE_KEY_VERSION=v1
