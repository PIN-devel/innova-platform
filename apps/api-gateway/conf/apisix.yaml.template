# Apache APISIX Stand-alone Declarative Configuration
# Note: Always keep the #END marker at the end of this file for APISIX hot-reload integrity.

routes:
  - id: gateway-health
    uri: /health
    methods:
      - GET
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - "return function(conf, ctx)
               ngx.status = 200;
               ngx.header['Content-Type'] = 'application/json';
               ngx.say('{\"status\":\"ok\",\"engine\":\"apache-apisix-standalone\"}');
               ngx.exit(200);
             end"

  - id: auth-service-proxy
    uris:
      - /api/auth/*
      - /api/admin/*
    priority: 10
    upstream:
      type: roundrobin
      scheme: ${UPSTREAM_AUTH_SCHEME}
      pass_host: rewrite
      upstream_host: "${UPSTREAM_AUTH_HOST}"
      nodes:
        "${UPSTREAM_AUTH_HOST}:${UPSTREAM_AUTH_PORT}": 1
      tls:
        verify: false
      timeout:
        connect: 60
        send: 60
        read: 120
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - "return function(conf, ctx)
               local origin = ngx.var.http_origin;
               local allowed_csv = '${ALLOWED_ORIGINS}';
               local origin_allowed = false;
               if origin and origin ~= '' then
                 for item in string.gmatch(allowed_csv, '([^,]+)') do
                   local trimmed = string.gsub(item, '^%s*(.-)%s*$', '%1');
                   if trimmed == origin then
                     origin_allowed = true;
                     break;
                   end
                 end
               end
               if ngx.req.get_method() == 'OPTIONS' then
                 if origin_allowed then
                   ngx.header['Access-Control-Allow-Origin'] = origin;
                   ngx.header['Access-Control-Allow-Credentials'] = 'true';
                   ngx.header['Access-Control-Allow-Methods'] = 'GET, POST, PUT, PATCH, DELETE, OPTIONS';
                   ngx.header['Access-Control-Allow-Headers'] = 'Content-Type, Accept, Authorization, X-Expected-User, X-Finance-Request, X-Request-Id';
                   ngx.header['Access-Control-Max-Age'] = '86400';
                   ngx.header['Vary'] = 'Origin';
                   ngx.status = 204;
                   ngx.exit(204);
                 else
                   ngx.status = 403;
                   ngx.exit(403);
                 end
               end

               local cookie = ngx.var.http_cookie;
               if cookie then
                 local m, err = ngx.re.match(cookie, '(?:^|;\\\\s*)__session=([^;]+)', 'jo');
                 if m and m[1] then
                   local new_cookie = cookie;
                   if not ngx.re.find(cookie, '(?:^|;\\\\s*)innova_auth=', 'jo') then
                     new_cookie = new_cookie .. '; innova_auth=' .. m[1];
                   end
                   if not ngx.re.find(cookie, '(?:^|;\\\\s*)exam_drill_auth=', 'jo') then
                     new_cookie = new_cookie .. '; exam_drill_auth=' .. m[1];
                   end
                   if new_cookie ~= cookie then
                     ngx.req.set_header('Cookie', new_cookie);
                   end
                 end
               end
             end"

      serverless-post-function:
        phase: header_filter
        functions:
          - "return function(conf, ctx)
               local origin = ngx.var.http_origin;
               local allowed_csv = '${ALLOWED_ORIGINS}';
               if origin and origin ~= '' then
                 for item in string.gmatch(allowed_csv, '([^,]+)') do
                   local trimmed = string.gsub(item, '^%s*(.-)%s*$', '%1');
                   if trimmed == origin then
                     ngx.header['Access-Control-Allow-Origin'] = origin;
                     ngx.header['Access-Control-Allow-Credentials'] = 'true';
                     ngx.header['Access-Control-Expose-Headers'] = 'X-Request-Id, Retry-After, retry-after-ms, Content-Disposition';
                     ngx.header['Vary'] = 'Origin, Cookie';
                     break;
                   end
                 end
               end

               local headers = ngx.resp.get_headers();
               local set_cookies = headers['Set-Cookie'];
               if not set_cookies then return end;

               if type(set_cookies) == 'string' then
                 set_cookies = { set_cookies };
               end

               local new_cookies = {};
               for _, sc in ipairs(set_cookies) do
                 table.insert(new_cookies, sc);
                 local m, err = ngx.re.match(sc, '^(?:innova_auth|exam_drill_auth)=([^;]*)', 'jo');
                 if m and m[1] then
                   local session_cookie;
                   if m[1] == '' or string.find(sc, 'Max%-Age=0') or string.find(sc, '1970') then
                     session_cookie = '__session=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Max-Age=0; SameSite=None; Secure; HttpOnly; Partitioned';
                   else
                     session_cookie = '__session=' .. m[1] .. '; Max-Age=900; Path=/; SameSite=None; Secure; HttpOnly; Partitioned';
                   end
                   table.insert(new_cookies, session_cookie);
                 end
               end
               ngx.header['Set-Cookie'] = new_cookies;
             end"

