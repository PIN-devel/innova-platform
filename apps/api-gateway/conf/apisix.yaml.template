# Apache APISIX Stand-alone Declarative Configuration
# Note: Always keep the #END marker at the end of this file for APISIX hot-reload integrity.

routes:
  - id: gateway-health
    uri: /health
    methods:
      - GET
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - "return function(conf, ctx)
               ngx.status = 200;
               ngx.header['Content-Type'] = 'application/json';
               ngx.say('{\"status\":\"ok\",\"engine\":\"apache-apisix-standalone\"}');
               ngx.exit(200);
             end"

  - id: legacy-api-proxy
    uri: /api/*
    upstream:
      type: roundrobin
      scheme: ${UPSTREAM_RENDER_SCHEME}
      pass_host: rewrite
      upstream_host: "${UPSTREAM_RENDER_HOST}"
      nodes:
        "${UPSTREAM_RENDER_HOST}:${UPSTREAM_RENDER_PORT}": 1
      tls:
        verify: false
      timeout:
        connect: 60s
        send: 60s
        read: 120s
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - "return function(conf, ctx)
               local cookie = ngx.var.http_cookie;
               if cookie then
                 local m, err = ngx.re.match(cookie, '(?:^|;\\\\s*)__session=([^;]+)', 'jo');
                 if m and m[1] then
                   local auth_cookie = 'exam_drill_auth=' .. m[1];
                   local new_cookie = cookie .. '; ' .. auth_cookie;
                   ngx.req.set_header('Cookie', new_cookie);
                 end
               end
             end"

      serverless-post-function:
        phase: header_filter
        functions:
          - "return function(conf, ctx)
               local headers = ngx.resp.get_headers();
               local set_cookies = headers['Set-Cookie'];
               if not set_cookies then return end;

               if type(set_cookies) == 'string' then
                 set_cookies = { set_cookies };
               end

               local new_cookies = {};
               for _, sc in ipairs(set_cookies) do
                 table.insert(new_cookies, sc);
                 local m, err = ngx.re.match(sc, '^exam_drill_auth=([^;]+)', 'jo');
                 if m and m[1] then
                   local session_cookie = '__session=' .. m[1] .. '; Path=/; SameSite=Lax; Secure; HttpOnly';
                   table.insert(new_cookies, session_cookie);
                 end
               end
               ngx.header['Set-Cookie'] = new_cookies;
             end"

#END
