# APISIX Gateway Upstream URLs for local / standalone run
# Defaults if unset:
# UPSTREAM_AUTH_URL: http://127.0.0.1:8081
# UPSTREAM_LEARNING_URL: http://127.0.0.1:8082
# UPSTREAM_FINANCE_URL: http://127.0.0.1:8083
# UPSTREAM_AI_URL: http://127.0.0.1:8084

UPSTREAM_AUTH_URL=http://127.0.0.1:8081
UPSTREAM_LEARNING_URL=http://127.0.0.1:8082
UPSTREAM_FINANCE_URL=http://127.0.0.1:8083
UPSTREAM_AI_URL=http://127.0.0.1:8084

# Optional comma-separated CORS allowed browser origins (defaults to http://localhost:5174,http://127.0.0.1:5174)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:8080

# Optional Zero Trust IAM ID token attachment for private Cloud Run upstreams
# (auto-enabled on Cloud Run when K_SERVICE is set; keep false for local and docker-compose)
# UPSTREAM_IAM_AUTH=false
